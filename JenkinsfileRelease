@Library('ontotext-platform@v0.1.56') _

/*
 * Release of graphwise-styleguide:
 *   1. Validate: the version is well formed, not released yet, and the npm token works.
 *   2. Build the package with the release version and generate the CSS variables summary for the release notes.
 *   3. Push the release commit and tag in one atomic push; rejected when the branch moved.
 *      A published npm version cannot be replaced, so nothing is published before the push.
 *   4. Publish the package to npm.
 *   5. Create the GitHub release; the package is already published, so a failure here only marks the build unstable.
 *
 * The steps are in .jenkins/release-steps.groovy, the Slack messages in .jenkins/release-notifications.groovy.
 */

def release
def notifications

pipeline {
    agent {
        label 'aws-small'
    }

    parameters {
        gitParameter name: 'GIT_BRANCH',
            description: 'The branch to check out',
            branchFilter: 'origin/(.*)',
            defaultValue: 'master',
            selectedValue: 'DEFAULT',
            type: 'PT_BRANCH',
            listSize: '0',
            quickFilterEnabled: true

        string name: 'RELEASE_VERSION',
            description: 'Version to release',
            defaultValue: ''

        string(
            name: 'SLACK_CHANNEL',
            defaultValue: '#frontend-notifications',
            description: 'Slack channel notified when the release succeeds, fails or is aborted'
        )

        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Build and validate, but run git push and npm publish with --dry-run and write the GitHub release notes to an archived file'
        )
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    // Loaded before the checkout, so they come from the same commit as this file.
                    release = load '.jenkins/release-steps.groovy'
                    notifications = load '.jenkins/release-notifications.groovy'
                }
            }
        }

        stage('Validate & Build') {
            steps {
                script {
                    release.checkout(params.GIT_BRANCH)
                    release.validate(params.RELEASE_VERSION)
                    release.build(params.RELEASE_VERSION, params.GIT_BRANCH)
                }
            }
        }

        stage('Push') {
            steps {
                script {
                    release.push(params.RELEASE_VERSION, params.GIT_BRANCH, params.DRY_RUN)
                }
            }
        }

        stage('Publish') {
            steps {
                script {
                    release.publish(params.RELEASE_VERSION, params.DRY_RUN)
                }
            }
        }

        stage('GitHub Release') {
            steps {
                // catchInterruptions: false, so that an abort or a timeout here is reported as an abort.
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                    script {
                        release.githubRelease(params.RELEASE_VERSION, params.GIT_BRANCH, params.DRY_RUN)
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                currentBuild.displayName = "${params.RELEASE_VERSION ?: currentBuild.displayName}"
            }
        }
        success {
            script {
                if (notifications) {
                    notifications.released(release.progress())
                }
            }
        }
        unsuccessful {
            script {
                // Not loaded when the build stopped before Prepare, e.g. in the SCM checkout.
                // No "?.": Groovy would still evaluate release.progress() and throw, skipping the mail.
                if (notifications) {
                    String result = currentBuild.currentResult
                    if (result == 'UNSTABLE') {
                        notifications.releasedWithoutGithubRelease(release.progress())
                    } else {
                        notifications.stopped(release.progress(), result == 'ABORTED')
                    }
                }
            }
            wrap([$class: 'BuildUser']) {
                sendMail(env.BUILD_USER_EMAIL)
            }
        }
        cleanup {
            script {
                release?.cleanup(params.RELEASE_VERSION)
            }
        }
    }
}
